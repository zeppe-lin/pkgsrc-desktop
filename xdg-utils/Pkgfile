# Description: Utilities for managing XDG MIME Applications
# URL:         https://gitlab.freedesktop.org/xdg/xdg-utils
# Depends on:  dash file xorg-xset xorg-xprop

# Maintainer notes on dependencies:
#   xorg-xset, xorg-xprop: needed inside xdg-screensaver
#
# P.S.
#   xdg-utils has a messy build dependencies, typical of many
#   freedesktop.org utilities.  Since the package consists only of
#   shell scripts, we avoid the upstream build complexity by reusing
#   the already built Arch Linux package.

name=xdg-utils
version=1.2.1
release=1
source=https://archive.archlinux.org/packages/x/$name/$name-$version-1-any.pkg.tar.zst

build() {
	rm -r $SRC/usr/share/licenses
	mv $SRC/usr $PKG/
}
