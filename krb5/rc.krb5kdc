#!/bin/sh
#
# /etc/rc.d/krb5kdc: start/stop krb5kdc(8) Kerberos V5 KDC
#

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/krb5kdc

case $1 in
start)
	$SSD --start --exec $PROG
	;;
stop)
	$SSD --stop --retry 10 --exec $PROG
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --verbose --exec $PROG
	;;
*)
	echo "Usage: $0 {start|stop|restart|status}"
	;;
esac

# End of file.
