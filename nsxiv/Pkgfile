version=34-054859b
release=1
#source=nsxiv-$version.tar.gz::https://codeberg.org/nsxiv/nsxiv/archive/v$version.tar.gz
source=nsxiv-$version.tar.gz::https://codeberg.org/nsxiv/nsxiv/archive/$_commit.tar.gz

build() {
	make -C nsxiv CFLAGS="$CFLAGS -DNDEBUG" all
	make -C nsxiv CFLAGS="$CFLAGS -DNDEBUG" \
		PREFIX=/usr DESTDIR=$PKG \
		install install-desktop install-icon

	# Remove junk
	rm -r $PKG/usr/share/doc
}
