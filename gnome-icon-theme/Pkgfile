# Description: Collection of icons used as the basis for GNOME themes
# URL:         https://www.gnome.org/
# Depends on:  gtk3 hicolor-icon-theme icon-naming-utils intltool

name=gnome-icon-theme
version=3.12.0
release=1
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz
	autoconf-2.70.patch
	icon-theme.cache"

build() {
	#patch -d $name-$version -p1 -i $SRC/autoconf-2.70.patch

	export LINGUAS=' '

	mkdir build; cd build

	# --enable-icon-mapping: enable compatibility symlinks
	../$name-$version/configure \
		--prefix=/usr \
		--disable-nls \
		--enable-icon-mapping \

	make V=1
	make DESTDIR=$PKG install

	install -m 0644 -Dt $PKG/usr/share/icons/gnome \
		$SRC/icon-theme.cache
}
