# Description: Standard unix password manager
# URL:         https://www.passwordstore.org/
# Depends on:  git gnupg tree xclip

# Notes on dependencies:
#   git:      Use password-store as the git repository (enabled)
#   xclip:    Copy to clipboard support (enabled)
#   qrencode: Display QR code (disabled)

name=password-store
version=1.7.4
release=4
source="https://git.zx2c4.com/$name/snapshot/$name-$version.tar.xz
	dynamic-load-ext.patch
	gnupg1-support.patch
	tree-2.0-compat.patch"

build() {
	cd $name-$version

	export WITH_BASHCOMP=yes # Enable bash completion
	export WITH_ZSHCOMP=no   # Disable zsh completion
	export WITH_FISHCOMP=no  # Disable fish completion

	patch -p1 -i $SRC/dynamic-load-ext.patch
	patch -p1 -i $SRC/gnupg1-support.patch
	patch -p1 -i $SRC/tree-2.0-compat.patch

	make PREFIX=/usr DESTDIR=$PKG install
}
