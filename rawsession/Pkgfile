# Description: Process-lifecycle authority for a rawmkit desktop session
# URL:         https://github.com/rawmkit/rawsession
# Depends on:  libconfig

name=rawsession
version=0.1.0-e5d4951
release=1
source=https://github.com/rawmkit/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	meson setup build $name-* \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D b_pie=true \
		-D b_lto=true \
		-D b_ndebug=true \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install

	# Remove junk
	rm -r $PKG/usr/share/licenses $PKG/usr/share/doc
}
