# Description: Monitor of system resources
# Maintainer:  UNMAINTAINED
# URL:         https://github.com/aristocratos/btop

name=btop
version=1.4.7-9527231
release=1
source=https://github.com/aristocratos/btop/archive/${version#*-}/btop-$version.tar.gz

build() {
	# Disable automagic lowdown(1) detection
	# Ensures reproducible build by preventing
	# optional manpage generation via lowdown
	sed -i 's/^if(LOWDOWN_EXECUTABLE)/if(FALSE)/' \
		btop-*/CMakeLists.txt

	cmake -S btop-* -B build -G Ninja \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D BUILD_TESTING=OFF \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install

	# Remove i18n entries
	sed -ri '/\[.+\]=/d' $PKG/usr/share/applications/btop.desktop
}
