# Description: Wraps normal socket connections with SSL/TLS
# URL:         https://www.stunnel.org/
# Depends on:  libnsl openssl zlib

name=stunnel
version=5.76
release=2
source="https://ftp.nluug.nl/pub/networking/$name/archive/${version%%.*}.x/$name-$version.tar.gz
	$name.conf
	rc.$name"

build() {
	mkdir build; cd build

	../$name-$version/configure \
		--prefix=/usr \
		--bindir=/usr/sbin \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--runstatedir=/run \
		--with-ssl=/usr \
		--disable-fips \
		--disable-systemd \
		--disable-libwrap \
		--enable-ipv6 \

	make V=1
	make DESTDIR=$PKG install

	install -m 0644 -D $SRC/stunnel.conf $PKG/etc/stunnel/stunnel.conf
	install -m 0755 -D $SRC/rc.stunnel $PKG/etc/rc.d/stunnel

	mkdir -p $PKG/etc/ssl/certs
	mkdir -p $PKG/etc/ssl/keys
	touch $PKG/etc/ssl/certs/stunnel.crt
	touch $PKG/etc/ssl/keys/stunnel.key
	chmod 0600 $PKG/etc/ssl/keys/stunnel.key

	# Remove junk
	rm -r $PKG/usr/share/doc
}
