# Description: Toolkit for XML Digital Signature and Encryption
# URL:         https://www.aleksey.com/xmlsec/index.html
# Depends on:  gnutls libtool libxslt nss openssl

name=xmlsec
version=1.3.10
release=1
source="https://github.com/lsh123/xmlsec/releases/download/$version/xmlsec1-$version.tar.gz
	xmlsec-1.3.0-optimisation.patch"

build() {
	patch -d xmlsec1-$version -p1 \
		-i $SRC/xmlsec-1.3.0-optimisation.patch

	# Disable unit tests
	sed -i '/^noinst_PROGRAMS = xmlsec_unit_tests/d' \
		$SRC/xmlsec1-$version/apps/Makefile.am

	mkdir build; cd build

	autoreconf -fiv ../xmlsec1-$version

	# Test failure (silent) with dash as /bin/sh.
	# https://bugs.gentoo.org/721128
	CONFIG_SHELL=/bin/bash \
	../xmlsec1-$version/configure \
		--prefix=/usr \
		--disable-static \
		--disable-docs \
		--disable-werror \

	# Ensure --as-needed is applied to shared linker invocations
	sed -i 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool

	make V=1
	make DESTDIR=$PKG install

	# Remove libtool archives
	rm $PKG/usr/lib/*.la
}
