# Description: dmenu‐based interface to pass
# URL:         https://www.passwordstore.org/
# Depends on:  password-store dmenu scdoc xdotool

name=passmenu
version=1.7.4 # keep in sync with password-store
release=1
source="https://git.zx2c4.com/password-store/snapshot/password-store-$version.tar.xz
	passmenu.1.scdoc"

build() {
	install -m 0755 -Dt $PKG/usr/bin \
		password-store-$version/contrib/dmenu/passmenu

	mkdir -p $PKG/usr/share/man/man1
	scdoc < $SRC/passmenu.1.scdoc > \
		$PKG/usr/share/man/man1/passmenu.1
}
