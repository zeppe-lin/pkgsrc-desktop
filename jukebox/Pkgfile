# Description: Music player for large collection (fork of gmusicbrowser)
# URL:         https://github.com/jukebox-sound/jukebox
# Depends on:  p5-gtk2 p5-net-dbus

name=jukebox
version=1.1.15.3-5ae886d
release=1
source=https://github.com/jukebox-sound/$name/archive/${version##*-}/$name-$version.tar.gz

build() {
	cd jukebox-*

	make PREFIX=/usr DESTDIR=$PKG install

	# Remove junk
	rm -r $PKG/usr/share/doc
	rm $PKG/usr/share/jukebox/pix/LICENSE \
	   $PKG/usr/share/jukebox/pix/README
}
