# Description: Mozilla Firefox standalone web browser
# URL:         https://www.mozilla.org/en-US/firefox/
# Depends on:  alsa-lib dbus-glib desktop-file-utils gtk3 nss xorg-libxtst hicolor-icon-theme

# Notes on dependencies:
#   desktop-file-utils: needed only by post-install script

name=firefox-bin
version=152.0.3
release=1
source="https://ftp.mozilla.org/pub/firefox/releases/$version/linux-x86_64/en-US/firefox-$version.tar.xz
	policies.json
	firefox.sh
	firefox.desktop
	revdep.$name"

build() {
	# Install Firefox to /opt and add launcher to /usr/bin
	mkdir -p $PKG/opt $PKG/usr/bin
	mv $SRC/firefox $PKG/opt/firefox
	install -m 0755 -D $SRC/firefox.sh $PKG/usr/bin/firefox
	install -m 0644 -Dt $PKG/usr/share/applications \
		$SRC/firefox.desktop

	# Install hicolor icons
	for x in 16 32 48 64 128; do
		_src_dir=/opt/firefox/browser/chrome/icons/default
		_dst_dir=/usr/share/icons/hicolor/${x}x${x}/apps

		mkdir -p $PKG${_dst_dir}
		ln -s ../../../../../..${_src_dir}/default${x}.png \
			$PKG${_dst_dir}/firefox.png
	done

	# Disable automatic updates via policies
	install -m 0644 -Dt $PKG/opt/firefox/distribution \
		$SRC/policies.json

	# Register /opt/firefox for revdep(1) library checks
	install -m 0644 -D $SRC/revdep.$name $PKG/etc/revdep.d/$name
}
