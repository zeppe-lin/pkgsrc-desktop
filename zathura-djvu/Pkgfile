# Description: DJVU plugin for zathura
# URL:         https://pwmt.org/projects/zathura-djvu
# Depends on:  desktop-file-utils djvulibre shared-mime-info zathura

# Maintainer notes on dependencies:
#   desktop-file-utils:  needed at post-install to update desktop entry cache
#   shared-mime-info:    needed at post-install to update MIME type database

name=zathura-djvu
version=2026.02.03
release=2
source=https://pwmt.org/projects/$name/download/$name-$version.tar.xz

build() {
	meson setup build $name-$version \
		--prefix=/usr \
		--sysconfdir=/usr/etc \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D b_lto=true \
		-D b_pie=true \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install

	# Fix permissions
	find $PKG -perm /go+w -exec chmod go-w {} \;

	# Remove junk
	rm -r $PKG/usr/share/metainfo
}
