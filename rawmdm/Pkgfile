# Description: Experimental X11 display manager for rawmkit
# URL:         https://github.com/rawmkit/rawmdm
# Depends on:  libxcrypt rawsession xorg-libx11 xorg-server

name=rawmdm
version=0.1.0-38b3afb
release=1
source="https://github.com/rawmkit/$name/archive/${version#*-}/$name-$version.tar.gz
	$name.conf
	rc.$name"

build() {
	# Disable tests
	sed -i "/^subdir('tests')/d" $name-*/meson.build

	meson setup build $name-* \
		--prefix=/usr \
		--sbindir=sbin \
		--libdir=lib \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D b_pie=true \
		-D b_lto=true \
		-D b_ndebug=true \
		-D xvfb_tests=disabled \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install

	install -m 0755 -D $SRC/rc.$name $PKG/etc/rc.d/$name
	install -m 0644 -D $SRC/$name.conf $PKG/etc/$name.conf
}
