#!/bin/sh -ex

export PATH="/sbin:/usr/sbin:/bin:/usr/bin"

if ! getent group rawmdm-greeter >/dev/null; then
	groupadd -r rawmdm-greeter
fi

if ! getent passwd rawmdm-greeter >/dev/null; then
	useradd -g rawmdm-greeter -r -d /var/empty -s /bin/false rawmdm-greeter
fi

passwd -l rawmdm-greeter

# End of file.
