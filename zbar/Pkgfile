# Description: Application/Library for reading bar codes from various sources
# URL:         https://github.com/mchehab/zbar
# Depends on:  imagemagick xorg-libxv

# Notes on dependencies:
#   imagemagick: scan and decode bar codes from images (enabled)

name=zbar
version=0.23.93
release=2
source=https://github.com/mchehab/zbar/archive/$version/zbar-$version.tar.gz

build() {
	mkdir build; cd build

	autoreconf -fiv ../zbar-$version
	CONFIG_SHELL=/bin/bash \
	../zbar-$version/configure \
		--prefix=/usr \
		--disable-nls \
		--disable-doc \
		--without-dbus \
		--without-gtk \
		--without-gir \
		--without-python \
		--without-qt \
		--without-java \

	# Ensure --as-needed is applied to shared linker invocations
	sed -i 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool

	make V=1
	make DESTDIR=$PKG install

	# Remove junk
	rm -r $PKG/usr/share/doc
}
