# Description: GTK+ 3.x simple text editor
# URL:         https://github.com/stevenhoneyman/l3afpad
# Depends on:  desktop-file-utils gtk3

# Notes on dependencies:
#   desktop-file-utils: required only for post-install script

name=leafpad
version=0.8.18.1.11-16f2222
release=1
source=https://github.com/stevenhoneyman/l3afpad/archive/${version#*-}/l3afpad-$version.tar.gz

build() {
	export LINGUAS=' '

	mkdir build; cd build

	autoreconf -fiv ../l3afpad-*
	../l3afpad-*/configure \
		--prefix=/usr \
		--disable-nls \

	make V=1
	make DESTDIR=$PKG install
}
