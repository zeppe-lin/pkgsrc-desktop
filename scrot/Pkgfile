# Description: Command-line screenshot utility for X
# URL:         https://github.com/resurrecting-open-source-projects/scrot
# Depends on:  autoconf-archive imlib2 xorg-libxcomposite xorg-libxrandr

name=scrot
version=2.0.0
release=1
source=https://github.com/resurrecting-open-source-projects/scrot/archive/$version/scrot-$version.tar.gz

build() {
	mkdir build; cd build

	autoreconf -fiv ../scrot-$version
	../scrot-$version/configure \
		--prefix=/usr \
		--mandir=/usr/share/man \

	make V=1
	make DESTDIR=$PKG install

	# Install bash completion
	install -m 0644 -Dt $PKG/usr/share/bash-completion/completions \
		../scrot-$version/etc/bash-completion/scrot

	# Remove junk and zsh completion
	rm -r $PKG/usr/share/doc $PKG/usr/share/zsh
}
