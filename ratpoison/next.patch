 {
-  XRRScreenResources *res;
-  XRROutputInfo *outinfo;
+  int nmonitors = 0;
+  XRRMonitorInfo *monitors;
   int *output_array;
-  int count = 0;
-  int i;
-
-  res = XRRGetScreenResources (dpy, RootWindow (dpy, DefaultScreen (dpy)));
-  output_array = xmalloc (res->noutput * sizeof(int));
-
-  for (i = 0; i < res->noutput; i++) {
-    outinfo = XRRGetOutputInfo (dpy, res, res->outputs[i]);
-    if (!outinfo->crtc)
-      continue;
-
-    output_array[count++] = res->outputs[i];
-
-    XRRFreeOutputInfo (outinfo);
-  }
-
-  XRRFreeScreenResources (res);
 
-  *outputs = output_array;
-  return count;
+  /* Query active logical monitors instead of physical outputs */
+   monitors = XRRGetMonitors (dpy, RootWindow (dpy, DefaultScreen (dpy)), True, &nmonitors);
+   if (!monitors || nmonitors <= 0)
+     {
+       if (monitors)
+         XRRFreeMonitors (monitors);
+       *outputs = NULL;
+       return 0;
+     }
+
+   output_array = xmalloc (nmonitors * sizeof(int));
+   for (int i = 0; i < nmonitors; i++)
+     {
+       /* Map monitor indices as pseudo-output ID's to preserve ratpoison's internal arrays */
+       output_array[i] = i;
+     }
+
+   XRRFreeMonitors (monitors);
+   *outputs = output_array;
+   return nmonitors;
 }
 
 static rp_screen *
@@ -120,40 +121,35 @@ xrandr_is_primary (rp_screen *screen)
 void
