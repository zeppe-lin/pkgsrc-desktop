-  res = XRRGetScreenResourcesCurrent (dpy, RootWindow (dpy, DefaultScreen (dpy)));
-  outinfo = XRRGetOutputInfo (dpy, res, rr_output);
-  if (!outinfo->crtc)
-    goto free_res;
+  monitors = XRRGetMonitors (dpy, RootWindow (dpy, DefaultScreen (dpy)), True, &nmonitors);
+  if (!monitors || rr_output >= nmonitors)
+    {
+      if (monitors)
+        XRRFreeMonitors (monitors);
 
-  crtinfo = XRRGetCrtcInfo (dpy, res, outinfo->crtc);
-  if (!crtinfo)
-    goto free_out;
+      return;
+    }
 
-  primary = XRRGetOutputPrimary (dpy, RootWindow (dpy, DefaultScreen (dpy)));
-  if (rr_output == primary)
-    screen->xrandr.primary = 1;
-  else
-    screen->xrandr.primary = 0;
+  XRRMonitorInfo *mon = &monitors[rr_output];
 
-  screen->xrandr.name = xstrdup (outinfo->name);
+  screen->xrandr.primary = mon->primary;
+  atom_name = XGetAtomName (dpy, mon->name);
+  screen->xrandr.name = xstrdup (atom_name ? atom_name : "N/A");
+  if (atom_name)
+    XFree (atom_name);
   screen->xrandr.output  = rr_output;
-  screen->xrandr.crtc    = outinfo->crtc;
+  screen->xrandr.crtc    = None; /* Logical monitors abstract away physical CRTCs */
 
-  screen->left   = crtinfo->x;
-  screen->top    = crtinfo->y;
-  screen->width  = crtinfo->width;
-  screen->height = crtinfo->height;
+  screen->left   = mon->x;
+  screen->top    = mon->y;
+  screen->width  = mon->width;
