+{
+  rp_window *win;
+  int num;
+
+  if (args[0] == NULL)
+    return cmdret_new (RET_SUCCESS, "%d", defaults.gap);
+
+  num = ARG(0,number);
+  if (num < 0)
+    return cmdret_new (RET_FAILURE, "gap: invalid argument '%s'", ARG_STRING(0));
