# Description: Keystroke-driven window manager
# URL:         https://www.nongnu.org/ratpoison/
# Depends on:  readline bash xorg-libxft xorg-libxrandr

# Notes:
#   This recipe uses the **unofficial** GitHub mirror and applies
#   the 'next' branch patchset (~13 commits) for modern features
#   (gap, urgency notifications, XRandR 1.5, etc).

name=ratpoison
version=1.4.9-db94d49
release=7
source="https://github.com/sighook/$name/archive/${version#*-}/$name-$version.tar.gz
	next.patch"

build() {
	# Apply consolidated patchset
	# (git format-patch master..next, squashed into next.patch)
	patch -d $name-* -p1 -i $SRC/next.patch

	# Skip building info documentation.
	sed -e '/^info_TEXINFOS/d' \
	    -e 's/ fdl.text//g'    \
	    -e 's/ texinfo.tex//g' \
	    -i $name-*/doc/Makefile.am

	mkdir build; cd build

	autoreconf -fiv ../$name-*
	../$name-*/configure \
		--prefix=/usr \
		--disable-debug \
		--enable-history \
		--with-xft \
		--with-xkb \
		--with-xrandr \

	make V=1 MAKEINFO=: CFLAGS="$CFLAGS -DHAVE_GETLINE"
	make MAKEINFO=: DESTDIR=$PKG install

	# Remove junk and unused stuff
	rm $PKG/usr/bin/rpws
	cd $PKG/usr/share
	rm -r doc ratpoison emacs
}
