# Description: Small X11 clipboard history service for rawmkit
# URL:         https://github.com/rawmkit/rawclip
# Depends on:  libconfig xorg-libxfixes

name=rawclip
version=1.0.0-b624c5a
release=1
source=https://github.com/rawmkit/$name/archive/${version#*-}/$name-$version.tar.gz

build() {
	meson setup build $name-* \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D b_pie=true \
		-D b_lto=true \
		-D b_ndebug=true \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install

	# Remove junk
	rm -r $PKG/usr/share/doc
}
