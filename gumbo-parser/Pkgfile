# Description: HTML5 parsing library in pure C99
# URL:         https://codeberg.org/gumbo-parser/gumbo-parser

name=gumbo-parser
version=0.14.1
release=1
source=$name-$version.tar.gz::https://codeberg.org/$name/$name/archive/$version.tar.gz

build() {
	meson setup build $name \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode=nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D tests=false \
		-D examples=false \
		-D fuzz=false \

	ninja -C build -j ${JOBS:-1} -v
	DESTDIR=$PKG ninja -C build install
}
