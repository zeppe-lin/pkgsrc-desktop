# Description: Keyboard and mouse configuration tool
# URL:         https://github.com/lxde/lxinput
# Depends on:  gtk3

# Notes on dependencies:
#   gtk: GTK2 GUI support (disabled by default)
#   --disable-man: otherwise requires docbook-xsl chain deps

name=lxinput
version=0.3.6
release=2
#source=https://downloads.sourceforge.net/lxde/$name-$version.tar.xz
source=$name-$version.tar.gz::https://github.com/lxde/$name/archive/refs/tags/$version.tar.gz

build() {
	# Disable i18n
	export LINGUAS=' '

	# Build in separate dir is broken
	cd $name-$version

	autoreconf -fiv
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-nls \
		--disable-gtk \
		--disable-man \
		--enable-gtk3 \

	make V=1
	make DESTDIR=$PKG install
}
