# Description: Buuf Nestort aka Buuf For Many Desktops icon set
# URL:         https://git.disroot.org/eudaimon/buuf-nestort
# Depends on:  hicolor-icon-theme gnome-icon-theme

name=buuf-nestort-icon-theme
_commit=2b8310d10bcff8783c425edf48947db3fc7c9f08
version=2.0-2b8310d
release=1
source="$name-$version.tar.gz::https://git.disroot.org/eudaimon/buuf-nestort/archive/$_commit.tar.gz
	icon-theme.cache"

build() {
	# Remove junk before installing
	rm buuf-nestort/*.sh buuf-nestort/*.md buuf-nestort/.git*

	mkdir -p $PKG/usr/share/icons
	mv buuf-nestort $PKG/usr/share/icons/Buuf-Nestort

	_theme_dir=$PKG/usr/share/icons/Buuf-Nestort

	#sed -i '/^Inherits=.*/d' ${_theme_dir}/index.theme
	sed -i '/^Inherits=/s/oxygen,//;s/,breeze//' \
		${_theme_dir}/index.theme

	# Fix long-long-long name
	sed -i 's/Name=Buuf For Many Desktops/Name=Buuf-Nestort/' \
		${_theme_dir}/index.theme

	# Fix broken links
	ln -sf ../symbolic/actions/send-to-symbolic.png \
		${_theme_dir}/actions/blueman-send.png
	ln -sf ../symbolic/actions/send-to-symbolic.png \
		${_theme_dir}/actions/document-share.png
	ln -sf ../symbolic/actions/send-to-symbolic.png \
		${_theme_dir}/actions/send-to.png
	ln -sf java.png ${_theme_dir}/apps/java25-openjdk.png
	ln -sf ../symbolic/emblems/emblem-symbolic-link.png \
		${_theme_dir}/apps/preferences-web-browser-shortcuts.png
	ln -sf ../symbolic/places/kde_badge-symbolic.png \
		${_theme_dir}/places/kde-plasma_badge-symbolic.png

	# Install theme cache file
	install -m 0644 -Dt ${_theme_dir} $SRC/icon-theme.cache
}
