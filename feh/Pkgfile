# Description: Fast and light imlib2-based image viewer
# URL:         https://feh.finalrewind.org/
# Depends on:  curl imlib2 libexif xorg-libxinerama

# Maintainer notes on dependencies:
#   curl=1: enable view https:// images, needs libcurl (enabled)
#   exif=1: builtin EXIF tag display support, needs libexif (enabled)
#   xinerama=1: support Xinerama/XRandR multiscreen setups, needs
#               xorg-libxinerama (enabled)

name=feh
version=3.11.3
release=1
source=https://github.com/derf/feh/archive/$version/feh-$version.tar.gz

build() {
	cd feh-$version

	export curl=1 exif=1 xinerama=1 help=1 inotify=1 stat64=1

	make PREFIX=/usr VERSION=$version
	make PREFIX=/usr VERSION=$version DESTDIR=$PKG install

	# Remove i18n entries
	sed -ri '/\[.+\]=/d' $PKG/usr/share/applications/feh.desktop

	# Remove junk
	rm -r $PKG/usr/share/doc
}
