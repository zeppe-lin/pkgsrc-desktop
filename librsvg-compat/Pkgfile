# Description: Legacy SVG rendering library with cairo backend
# URL:         https://wiki.gnome.org/LibRsvg
# Depends on:  gtk3 libcroco libxml2

name=librsvg-compat
version=2.40.21
release=2
source="https://download.gnome.org/sources/librsvg/${version%.*}/librsvg-$version.tar.xz
	librsvg-2.40.21-libxml2-modern.patch"

build() {
	patch -d librsvg-$version -p1 -i $SRC/librsvg-2.40.21-libxml2-modern.patch

	mkdir build; cd build

	../librsvg-$version/configure \
		--prefix=/usr \
		--disable-static \
		--enable-gtk-doc=no \
		--enable-vala=no \
		--enable-introspection=no \

	make V=1
	make DESTDIR=$PKG install

	# Remove junk
	rm $PKG/usr/lib/*.la
}
