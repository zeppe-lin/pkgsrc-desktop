# Description: Lightweight battery icon for the system tray
# URL:         https://github.com/valr/cbatticon
# Depends on:  libnotify gettext-tiny gtk3

name=cbatticon
version=1.6.13-de7fe22
release=1
source="https://github.com/valr/$name/archive/${version#*-}/$name-$version.tar.gz
	79.patch"

build() {
	cd $name-*

	patch -p1 -i $SRC/79.patch

	make PREFIX=/usr V=1 WITH_GTK3=1 WITH_NOTIFY=1
	make PREFIX=/usr DESTDIR=$PKG install

	# Remove junk
	rm -r $PKG/usr/share/locale $PKG/usr/share/doc
}
